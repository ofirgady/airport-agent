FROM python:3.13-slim

WORKDIR /app

COPY pyproject.toml ./
COPY airport_investment_agent ./airport_investment_agent
COPY client ./client
COPY .streamlit ./.streamlit
RUN pip install --no-cache-dir .

EXPOSE 8501

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8501/_stcore/health', timeout=3)" || exit 1

CMD ["streamlit", "run", "client/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
